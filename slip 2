Q2) B.Write a python program to implement Mini-Max Algorithm.                          
[20 marks] 
Program 

def minimax(depth, node_index, is_maximizing, values, 
height): 
# If leaf node is reached 
    if depth == height: 
        return values[node_index] 
    
    if is_maximizing: 
        return max( 
            minimax(depth + 1, node_index * 2, 
                False, values, height), 
            minimax(depth + 1, node_index * 2 + 1, 
                False, values, height) 
        ) 
 
    else: 
        return min( 
            minimax(depth + 1, node_index * 2, 
                    True, values, height), 
            minimax(depth + 1, node_index * 2 + 1, 
                    True, values, height) 
        ) 
 
 
# Main Program 
