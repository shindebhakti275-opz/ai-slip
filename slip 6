def alpha_beta(depth, node, alpha, beta, 
maximizing_player): 
    # Depth limit reached 
    if depth == 3: 
        return heuristic[node] 
 
    if maximizing_player: 
        best = -999 
 
        for i in range(2): 
            value = alpha_beta( 
                depth + 1, 
                node * 2 + i, 
                alpha, 
                beta, 
                False 
            ) 
 
            best = max(best, value) 
            alpha = max(alpha, best) 
 
            # Beta pruning 
            if beta <= alpha: 
                print("Beta Pruning at node:", node) 
                break 
 
        return best 
 
    else: 
        best = 999 
 
        for i in range(2): 
            value = alpha_beta( 
                depth + 1, 
                node * 2 + i, 
                alpha, 
                beta, 
                True 
            ) 
 
            best = min(best, value) 
            beta = min(beta, best) 
 
            # Alpha pruning 
            if beta <= alpha: 
                print("Alpha Pruning at node:", node) 
break 
return best 
