Q2)B.Apply Linear Regression on a YouTube Video dataset to predict video 
views using relevant video attributes. Visualize the relationship between the 
predictor and target variable using a scatter plot and regression line.                                            
[20 marks] 
Program 
# Linear Regression on YouTube Video Dataset 
import pandas as pd 
import matplotlib.pyplot as plt 
from sklearn.linear_model import LinearRegression 
# Create YouTube dataset 
data = { 
'Likes': [100, 250, 400, 550, 700, 900, 1100, 
1300, 1500, 1800], 
'Views': [2000, 4500, 7000, 9500, 12000, 15000, 
19000, 22000, 25000, 30000] 
} 
df = pd.DataFrame(data) 
print("YouTube Video Dataset:") 
print(df) 
# Predictor variable 
X = df[['Likes']] 
# Target variable 
Y = df['Views'] 
# Create Linear Regression model 
model = LinearRegression() 
# Train the model 
model.fit(X, Y) 
# Predict views 
likes = float(input("\nEnter number of likes: ")) 
prediction = model.predict([[likes]]) 
print("Predicted Views:", prediction[0]) 
 
# Plot scatter plot 
plt.scatter(df['Likes'], df['Views'], label="Actual 
Data") 
 
# Regression line 
plt.plot( 
    df['Likes'], 
    model.predict(X), 
    label="Regression Line" 
) 
 
# Labels and title 
plt.xlabel("Number of Likes") 
plt.ylabel("Number of Views") 
plt.title("YouTube Likes vs Views") 
 
# Legend 
plt.legend() 
 
# Display graph 
plt.show() 
